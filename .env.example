# Local contributor setup — see docs/LOCAL_DEV.md
# Never use production DATABASE_URL or Azure storage in local development.

DATABASE_URL=postgresql://aipm:aipm@localhost:5432/aipm
# AIPM_METADATA_BACKEND=postgres
AIPM_DATA_DIR=./data
HOST=127.0.0.1
PORT=8080

# Dev auth — one-click login without GitHub OAuth
AIPM_DEV_AUTH=1
AIPM_API_URL=http://localhost:3000
AIPM_PUBLIC_SITE_URL=http://localhost:3000
INDEXNOW_ENABLED=false
# INDEXNOW_SITE_URL=https://www.aipm-registry.com
# INDEXNOW_KEY must match the public /<key>.txt file. AIPM uses its checked-in key by default.
# INDEXNOW_KEY=8f24c0d56a1b4e38a2796fd31e07b5c9

# Local admin (password: local-admin)
AIPM_ADMIN_PASSWORD_SHA256=8aa203921e9b2adba121fbbe07504a30a9c1a647dd4961c1a355947280016649
AIPM_ADMIN_ALLOWED_USERNAMES=dev-local

# CLI default registry when publishing from another project
AIPM_REGISTRY=http://127.0.0.1:8080

# Optional — open local publish (no token gate)
# AIPM_REQUIRE_PUBLISH_TOKEN=true
# AIPM_PUBLISH_TOKEN_SHA256=<sha256-hex>
# AIPM_TOKEN=<raw-token-for-cli-publish-only>
