# Optional — registry auto-falls back to file metadata if Postgres is down
DATABASE_URL=postgresql://aipm:aipm@localhost:5432/aipm
# AIPM_METADATA_BACKEND=file   # force file index (no Docker/Postgres)
# AIPM_METADATA_BACKEND=postgres # force Postgres only
AIPM_DATA_DIR=./data
PORT=8080
AIPM_REGISTRY=http://localhost:8080
