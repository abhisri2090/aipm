# Database — local Docker Postgres (default) or production via Key Vault pull:
#   KEY_VAULT_NAME=<vault> ./infra/azure/pull-local-dev-secrets.sh
#   ./infra/azure/allow-local-postgres-ip.sh
DATABASE_URL=postgresql://aipm:aipm@localhost:5432/aipm
# AIPM_METADATA_BACKEND=file   # force file index (no Docker/Postgres)
# AIPM_METADATA_BACKEND=postgres # force Postgres only
AIPM_DATA_DIR=./data
HOST=127.0.0.1
PORT=8080
AIPM_REGISTRY=https://aipm-registry.com

# Production publish gate. Store only the hash on the server.
# Generate a token locally, then hash it:
#   openssl rand -base64 32
#   printf '%s' '<token>' | sha256sum
# AIPM_REQUIRE_PUBLISH_TOKEN=true
# AIPM_PUBLISH_TOKEN_SHA256=<sha256-hex>
# AIPM_TOKEN=<raw-token-for-cli-publish-only>

# Optional — use Azure Blob Storage for package tarballs instead of AIPM_DATA_DIR/packages
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=packages

# Local GitHub login — use pull-local-dev-secrets.sh for production DB + OAuth secrets,
# or set manually for Docker Postgres:
# GitHub OAuth app callbacks (add both for prod + local):
#   https://api.aipm-registry.com/v1/auth/github/callback
#   http://localhost:3000/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AIPM_SESSION_SECRET=
# AIPM_API_URL=http://localhost:3000
# AIPM_PUBLIC_SITE_URL=http://localhost:3000
