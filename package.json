{
  "name": "aipm",
  "private": true,
  "version": "0.0.0",
  "description": "AI package manager — monorepo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhisri2090/aipm.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "aipm": "node apps/cli/dist/bin.js",
    "registry": "pnpm --filter @aipm/registry-api build && pnpm --filter @aipm/registry-api start",
    "release:cli:dry-run": "pnpm build && pnpm -r --filter @aipm/schemas --filter @aipm/adapter-sdk --filter @aipm/adapter-cursor --filter @aipm/adapter-claude --filter @aipm/engine --filter @aipm/cli publish --dry-run --access public --no-git-checks",
    "release:cli:publish": "pnpm build && pnpm -r --filter @aipm/schemas --filter @aipm/adapter-sdk --filter @aipm/adapter-cursor --filter @aipm/adapter-claude --filter @aipm/engine --filter @aipm/cli publish --access public",
    "cli:link": "pnpm build && npm link --prefix apps/cli",
    "cli:unlink": "npm unlink -g @aipm/cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
