{
  "name": "aipm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI package manager — monorepo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aipm-registry/aipm.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test && pnpm test:root",
    "test:root": "vitest run scripts/*.test.mjs",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "eslint scripts eslint.config.js prettier.config.js",
    "typecheck": "turbo run typecheck",
    "scan:secrets": "node scripts/scan-secrets.mjs && pnpm local:check",
    "local:setup": "node scripts/local-setup.mjs",
    "local:api": "pnpm --filter @aipm-registry/registry-api build && node --env-file=.env --watch apps/registry-api/dist/index.js",
    "local:web": "pnpm --filter @aipm-registry/web dev",
    "local:seed": "node scripts/seed-from-public-registry.mjs",
    "local:db:pull": "node scripts/pull-prod-db-to-local.mjs",
    "local:check": "node scripts/check-local-safety-docs.mjs",
    "prod:smoke": "node scripts/production-smoke.mjs",
    "prod:smoke:list": "node scripts/production-smoke.mjs --list",
    "e2e:user": "node scripts/e2e-user-flow.mjs",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "aipm": "node apps/cli/dist/bin.cjs",
    "registry": "pnpm --filter @aipm-registry/registry-api build && pnpm --filter @aipm-registry/registry-api start",
    "release:cli:dry-run": "pnpm --filter @aipm-registry/cli build && pnpm --filter @aipm-registry/cli publish --dry-run --access public --no-git-checks",
    "release:cli:pack": "pnpm --filter @aipm-registry/cli build && rm -rf /tmp/aipm-cli-pack && mkdir -p /tmp/aipm-cli-pack && pnpm --dir apps/cli pack --pack-destination /tmp/aipm-cli-pack",
    "release:cli:binaries": "node scripts/build-cli-binaries.mjs",
    "release:cli:templates": "node scripts/render-cli-distribution-templates.mjs",
    "release:cli:publish": "pnpm --filter @aipm-registry/cli build && pnpm --filter @aipm-registry/cli publish --access public --no-git-checks",
    "release:check": "node scripts/check-release-plumbing.mjs",
    "release:version-from-tag": "node scripts/set-package-version-from-tag.mjs",
    "cli:link": "pnpm build && npm link --prefix apps/cli",
    "cli:unlink": "npm unlink -g @aipm-registry/cli",
    "import-skill": "node scripts/import-skill.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@yao-pkg/pkg": "^6.20.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "globals": "^17.6.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
