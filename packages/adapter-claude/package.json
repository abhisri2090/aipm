{
  "name": "@aipm-registry/adapter-claude",
  "version": "0.1.0",
  "description": "Claude adapter for installing AIPM skill packages.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://www.aipm-registry.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhisri2090/aipm.git",
    "directory": "packages/adapter-claude"
  },
  "bugs": {
    "url": "https://github.com/abhisri2090/aipm/issues"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aipm-registry/adapter-sdk": "workspace:*",
    "@aipm-registry/schemas": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
