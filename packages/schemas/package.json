{
  "name": "@aipm/schemas",
  "version": "0.1.0",
  "description": "Shared schemas and validation helpers for AIPM packages.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://aipm-registry.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhisri2090/aipm.git",
    "directory": "packages/schemas"
  },
  "bugs": {
    "url": "https://github.com/abhisri2090/aipm/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
